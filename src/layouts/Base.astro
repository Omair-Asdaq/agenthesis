---
import Brand from '../components/Brand.astro';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const {title = 'AGENTHESIS — Research into intelligence that acts', description = 'An independent, open-source learning journal exploring agentic AI research, mechanisms, experiments and evidence.'} = Astro.props;
const fullTitle = title.startsWith('AGENTHESIS') ? title : title + ' — AGENTHESIS';
const canonical = new URL(Astro.url.pathname, 'https://agenthesis.tech').toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#151d28"/>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link rel="alternate" type="application/rss+xml" title="AGENTHESIS research feed" href="/rss.xml"/>
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content="AGENTHESIS"/>
  <meta property="og:title" content={fullTitle}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <title>{fullTitle}</title>
</head>
<body>
  <div class="topline">
    <div class="shell topline-inside">
      <span><span class="pulse"></span> AN INDEPENDENT RESEARCH JOURNAL</span>
      <span class="topline-right">BUILT FOR CURIOSITY, NOT THE HYPE CYCLE</span>
    </div>
  </div>
  <header class="site-header">
    <div class="shell header-inside">
      <Brand />
      <nav aria-label="Main navigation">
        <a class:list={['nav-link',{active:Astro.url.pathname==='/'}]} href="/">Discover</a>
        <a class:list={['nav-link',{active:Astro.url.pathname.startsWith('/topics')}]} href="/topics">Topics</a>
        <a class:list={['nav-link',{active:Astro.url.pathname==='/about'}]} href="/about">About</a>
        <a class="nav-link desktop-only" href="https://github.com/Omair-Asdaq/agenthesis" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle theme">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20.4 15.7A8.5 8.5 0 0 1 8.3 3.6 8.5 8.5 0 1 0 20.4 15.7Z" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site-footer">
    <div class="shell">
      <div class="footer-upper">
        <div>
          <Brand compact />
          <p>Less noise. Better questions.<br/>A field journal for agentic intelligence.</p>
        </div>
        <div class="footer-links">
          <a href="/">Discover</a><a href="/topics">Topics</a><a href="/about">Our method</a><a href="/rss.xml">RSS ↗</a><a href="https://github.com/Omair-Asdaq/agenthesis" target="_blank" rel="noopener noreferrer">Source ↗</a>
        </div>
      </div>
      <div class="footer-lower">
        <span>© 2026 AGENTHESIS. OPEN KNOWLEDGE, OPEN QUESTIONS.</span>
        <span>INDEPENDENT · OPEN SOURCE · <a href="https://agenthesis.tech">AGENTHESIS.TECH</a></span>
      </div>
    </div>
  </footer>
  <script is:inline>
    (function(){
      var root=document.documentElement;
      try{root.dataset.theme=localStorage.getItem('agenthesis-theme')||'light'}catch(e){}
      var t=document.getElementById('theme-toggle');
      if(t)t.addEventListener('click',function(){
        var next=root.dataset.theme==='dark'?'light':'dark';
        root.dataset.theme=next;
        try{localStorage.setItem('agenthesis-theme',next)}catch(e){}
      });
    })();
  </script>
</body>
</html>
