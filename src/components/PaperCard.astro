---
import type { ResearchPaper } from '../data/papers';
import { formatDate } from '../data/papers';
interface Props { paper: ResearchPaper; index?: number; }
const { paper, index = 0 } = Astro.props;
---
<article class:list={['paper-card', paper.accent]} data-research-card data-title={paper.title.toLowerCase()} data-search={[paper.title,paper.subtitle,paper.category,paper.tags.join(' '),paper.authors].join(' ').toLowerCase()} data-category={paper.category}>
  <div class="paper-card-top">
    <span class="paper-index">{String(index+1).padStart(2,'0')} / RESEARCH NOTE</span>
    <span class="paper-tag">{paper.category}</span>
  </div>
  <a class="paper-click" href={'/research/' + paper.slug} aria-label={'Read ' + paper.title}>
    <div class="paper-symbol" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <h3>{paper.title}</h3>
    <p>{paper.subtitle}</p>
    <div class="paper-card-footer">
      <span>{formatDate(paper.publishedOn)} <span class="dot-sep">·</span> {paper.readMinutes} min</span>
      <span class="card-arrow">↗</span>
    </div>
  </a>
</article>
<style>
.paper-card{background:var(--card);border:1px solid var(--border);border-radius:12px;min-height:322px;position:relative;display:flex;flex-direction:column;transition:border-color .25s,transform .25s,box-shadow .25s;overflow:hidden}
.paper-card:hover{transform:translateY(-4px);border-color:var(--accent-faded);box-shadow:0 20px 45px var(--shadow)}
.paper-card-top{display:flex;justify-content:space-between;align-items:center;padding:20px 23px 0;gap:8px}
.paper-index{font-size:10px;font-weight:800;letter-spacing:.14em;color:var(--muted)}
.paper-tag{font-size:11px;border-radius:999px;border:1px solid var(--border);padding:5px 9px;color:var(--ink-soft)}
.paper-click{color:inherit;text-decoration:none;display:flex;flex:1;flex-direction:column;padding:17px 23px 20px}
.paper-click h3{font-size:clamp(1.18rem,1.6vw,1.47rem);letter-spacing:-.045em;line-height:1.22;margin:10px 0 10px;font-weight:750}
.paper-click p{color:var(--ink-soft);font-size:.91rem;line-height:1.63;margin:0 0 26px}
.paper-symbol{display:flex;gap:5px;align-items:center;height:35px}
.paper-symbol span{display:block;width:10px;height:10px;border-radius:3px;background:var(--accent);transform:rotate(45deg)}
.paper-symbol span:nth-child(2){height:19px;width:19px;border-radius:4px;opacity:.45}
.paper-symbol span:nth-child(3){height:7px;width:7px;opacity:.32}
.blue .paper-symbol span{background:#5b88d8}
.mint .paper-symbol span{background:#43ab95}
.peach .paper-symbol span{background:#e7a27a}
.paper-card-footer{display:flex;justify-content:space-between;align-items:center;margin-top:auto;border-top:1px solid var(--border);padding-top:17px;font-size:11px;letter-spacing:.03em;color:var(--muted)}
.dot-sep{padding:0 4px}
.card-arrow{color:var(--ink);font-size:23px;font-weight:350;line-height:1}
</style>
