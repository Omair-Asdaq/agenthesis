---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="shell simple-page" style="min-height:65vh">
    <div class="kicker">ERROR / 404</div>
    <h1>This path leads<br/><span style="color:var(--accent)">somewhere else.</span></h1>
    <p class="intro">The page might have moved, or the research trail may have changed.</p>
    <a class="btn btn-primary" href="/">Return to Discover ↗</a>
  </div>
</Base>
